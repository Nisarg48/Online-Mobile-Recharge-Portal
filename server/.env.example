# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.

# Environment: "production" disables dev conveniences (LAN CORS, OTP echo).
NODE_ENV=development

# Server
PORT=5000

# Comma-separated list of allowed browser origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (local or Atlas)
CONNECTION_STRING=mongodb://127.0.0.1:27017/mobile-recharge-portal

# JWT secrets (use long random strings, e.g. `openssl rand -hex 32`)
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret

# OTP + notification delivery. Real SMS is not wired up yet; with nothing set the
# OTP is only written to the server console (never sent to the browser). When the
# email account below is configured, the OTP is also emailed to the user.

# Email channel (free): Nodemailer over Gmail. Not required.
# Use a Google "App Password", not your normal password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
