# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.

# Server
PORT=5000

# MongoDB connection string (local or Atlas)
CONNECTION_STRING=mongodb://127.0.0.1:27017/mobile-recharge-portal

# JWT secrets (use long random strings, e.g. `openssl rand -hex 32`)
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret

# Nodemailer (query reply emails). For Gmail use an App Password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Twilio (OTP SMS). Optional until SMS delivery is enabled.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
